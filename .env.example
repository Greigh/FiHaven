# Copy this file to .env and fill in values for your environment.
#
# Env loading (first match wins — see server/index.js):
#   .env.<NODE_ENV>.local  →  .env.local  →  .env.<NODE_ENV>  →  .env
#
# Local dev: copy Turnstile test keys from Cloudflare or leave blank and
# set them in .env. Production deploy: fill .env with live secrets; upload.sh
# ships a sanitized subset to the VPS (never overwrites remote data/).
#
# If .env holds the production MFA_ENCRYPTION_KEY but your laptop has its
# own data/mfa.key, put the local hex in .env.development.local (gitignored)
# so npm run dev keeps decrypting local ciphertext.

NODE_ENV=development
PORT=5222

# Cloudflare Turnstile keys. Sign up free at
# https://dash.cloudflare.com/?to=/:account/turnstile and create
# a widget; you'll get a sitekey + secret pair.
TURNSTILE_SECRET=
TURNSTILE_SITEKEY=
# Re-expose the sitekey to Vite (same value as TURNSTILE_SITEKEY).
# Vite only reads variables prefixed with VITE_; this lets us
# inline the sitekey into login.html at build time so Turnstile
# can render immediately instead of waiting on an API round-trip.
VITE_TURNSTILE_SITEKEY=

# Session cookie name and lifetime.
SESSION_COOKIE=ct_sid
SESSION_TTL_HOURS=12

# SMTP — used to send sign-in codes for email-based MFA. In
# production the VPS runs Postfix on loopback (no auth needed).
# In dev, the server still tries to connect; either install a
# local SMTP server, set SMTP_HOST to a relay, or leave email-MFA
# disabled in the dev account.
SMTP_HOST=localhost
SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=FiHaven <no-reply@fihaven.app>

# Required in production: 32-byte hex key for AES-256-GCM at-rest
# encryption of TOTP secrets, Plaid access tokens, and user_data JSON.
# Generate with: openssl rand -hex 32
# If you previously ran without this set, copy the hex from data/mfa.key
# into MFA_ENCRYPTION_KEY so existing ciphertext keeps decrypting.
# Leaving it unset falls back to data/mfa.key (fine for local dev;
# production boots with a warning and upload.sh refuses to deploy).
# When .env has the production key, override with your laptop's
# data/mfa.key hex in .env.development.local for local npm run dev.
# MFA_ENCRYPTION_KEY=

# ── Paddle (web premium purchases) ──────────────────────────────
# Paddle is the MERCHANT OF RECORD for web checkout: it sells to the
# customer, takes the payment, handles sales tax/VAT, and reports back
# over webhooks. FiHaven only records the resulting entitlement.
#
# Client-side token (live_… or test_…). PUBLIC by design — it ships in
# the browser bundle and is served from /api/billing/paddle/config.
# If it is unset, checkout falls back to a local dev-grant (never in prod).
PADDLE_CLIENT_TOKEN=
# Server-side API key (pdl_live_apikey_… / pdl_sdbx_apikey_…). SECRET:
# it can create and refund transactions and read customer data. Server
# only — never expose it to the browser, never commit it.
PADDLE_API_KEY=
# 'production' (default) or 'sandbox'. Live is the default deliberately,
# so a missing value can never silently point production at test data.
PADDLE_ENV=production
# Price IDs (pri_…) from Paddle → Catalog → Products. Each plan with a
# price set is offered on the web paywall automatically; leave a line
# blank to hide that plan. The 7-day free trial lives on the PRICE in
# Paddle (monthly and yearly carry one; Family deliberately does not),
# so there is nothing to configure here for it.
# THREE_MONTH/TRIAL are optional extra intervals — leave blank unless
# you deliberately offer them.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
PADDLE_PRICE_FAMILY=
PADDLE_PRICE_THREE_MONTH=
PADDLE_PRICE_TRIAL=
# Signing secret (pdl_ntfset_…) from the notification destination you
# create at Paddle → Developer tools → Notifications, pointing at
# {PUBLIC_ORIGIN}/api/billing/paddle/webhook.
# Events: subscription.created/activated/updated/canceled/paused/resumed/
# past_due, transaction.completed.
# Paddle shows this secret ONCE — if it is lost, create a NEW destination
# rather than trying to recover it. Unset means signatures are NOT
# verified, which the server refuses to allow in production.
PADDLE_WEBHOOK_SECRET=
# Public origin for checkout returns, webhooks and Pub/Sub audiences
# (no trailing slash), e.g. https://fihaven.app. REQUIRED in production —
# the server refuses to start without an https:// PUBLIC_ORIGIN.
PUBLIC_ORIGIN=

# Content-Security-Policy enforcement. The policy ships in Report-Only mode so
# a missed third-party origin logs a console violation instead of breaking
# checkout or bank linking. Exercise sign-in (Turnstile / Google / Apple),
# Paddle checkout and Plaid Link, confirm the console is clean, then set this
# to 1 to enforce. See server/securityHeaders.js.
#
# NOTE: the policy names each inline <script> by SHA-256 hash. After editing an
# inline script in client/*.html, run `node scripts/csp-hashes.js` and update
# the list, or that page's inline script will be blocked once enforcing.
#
# Cloudflare: Bot Fight Mode injects a per-request JS Detections snippet. We
# emit a CSP nonce each response so Cloudflare can stamp that tag (hashes
# alone can never match it). Web Analytics auto-injection needs
# static.cloudflareinsights.com in script-src (already listed). If the beacon
# GETs fail with ERR_CONNECTION_REFUSED, that's local network/adblock — disable
# Web Analytics auto-setup in the Cloudflare dashboard to silence it.
# CSP_ENFORCE=1

# ── IndexNow (Bing, Yandex, etc.) ───────────────────────────────
# Optional. 8–128 hex chars; hosted at {PUBLIC_ORIGIN}/{key}.txt after
# build. Notifies search engines when you run npm run indexnow (also
# called automatically at the end of deploy when the key is set).
# Generate: openssl rand -hex 32
# INDEXNOW_KEY=

# ── Plaid (optional, Pro-gated bank linking) ────────────────────
# Bank syncing is a paid convenience overlay — the app works fully by
# hand without it. Get free Sandbox credentials at
# https://dashboard.plaid.com/signup (Team Settings → Keys).
# Leave the client_id/secret blank to keep the feature off (the UI then
# shows "not available on this server"). The access_token is stored
# encrypted at rest (AES-256-GCM, same key as MFA secrets).
#
# Your client_id is the SAME across environments; the secret is
# per-environment. You can use the generic names below, OR keep both
# environments' keys side by side with PLAID_SANDBOX_SECRET /
# PLAID_PRODUCTION_SECRET — the secret matching PLAID_ENV is used.
PLAID_CLIENT_ID=
PLAID_SECRET=
# PLAID_SANDBOX_SECRET=
# PLAID_PRODUCTION_SECRET=
# 'sandbox' (default, fake banks + test creds) or 'production'.
PLAID_ENV=sandbox
# Comma-separated Plaid products + ISO country codes.
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Optional: public HTTPS URL Plaid posts item/transactions webhooks to,
# e.g. https://fihaven.app/api/plaid/webhook. Needed for live updates.
PLAID_WEBHOOK_URL=
# The webhook's signed Plaid-Verification JWT is required whenever this server
# runs with NODE_ENV=production, or whenever PLAID_ENV=production. Plaid does
# not sign SANDBOX webhooks, so a deployed staging box pointed at sandbox would
# reject everything — set this to 1 there to accept unsigned payloads. It is
# ignored when PLAID_ENV=production. Never set it on the real deployment: the
# endpoint drives billable Plaid syncs for any item_id a caller names.
# PLAID_ALLOW_UNSIGNED_WEBHOOKS=1
# Browser (web) OAuth return — must be allow-listed in the Plaid Dashboard.
# Example: https://fihaven.app/plaid-oauth
PLAID_REDIRECT_URI=
# Native iOS Universal Link (native Link only). Defaults to
# ${PUBLIC_ORIGIN}/plaid when unset. Allow-list separately in the Dashboard;
# do NOT reuse PLAID_REDIRECT_URI (/plaid-oauth) or OAuth banks land in Safari.
# PLAID_IOS_REDIRECT_URI=https://fihaven.app/plaid
# Native Android package for OAuth return (no redirect_uri). Must match the
# app package registered in the Plaid Dashboard.
# PLAID_ANDROID_PACKAGE=app.fihaven

# ── Social sign-in (Sign in with Apple / Google) ────────────────
# Optional. A provider stays disabled until its audience(s) are set, so
# "Continue with …" buttons only appear once configured. Full setup
# walkthrough: docs/social-login-setup.md
#
# How tokens are verified. 'dev-trust' decodes the ID token WITHOUT
# checking its signature (local testing with hand-made tokens only);
# 'production' verifies the RS256 signature against the provider JWKS
# and validates iss/aud/exp. Defaults to production when NODE_ENV is
# production, else dev-trust. FORBIDDEN in production (server exits).
# OAUTH_VERIFY_MODE=production
#
# Comma-separated allowed audiences (the "aud" claim). Google: the Web
# client id (web button) and the iOS client id. Android sign-in uses the
# WEB client id as its serverClientId, so Android tokens already carry the
# Web aud — don't add a separate Android client id here.
GOOGLE_OAUTH_CLIENT_ID=
# Apple: your Services ID (web button uses the FIRST entry) then the iOS app
# bundle id, e.g. app.fihaven.web,app.fihaven
APPLE_CLIENT_ID=

# ── Passkeys (WebAuthn) ─────────────────────────────────────────
# Web + iOS passkeys use rpID fihaven.app and PUBLIC_ORIGIN in production.
# Android native sign-in needs each release's apk-key-hash allow-listed:
# comma-separated android:apk-key-hash:… entries (one per signing key /
# build variant). upload.sh ships PASSKEY_* vars to production .env.
# PASSKEY_ANDROID_ORIGIN=android:apk-key-hash:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Operations & admin ──────────────────────────────────────────
# Comma-separated admin emails (grants server-side admin routes in production).
# ADMIN_EMAILS=you@example.com
# Inbox for subscription-link feedback (defaults to support@fihaven.app).
# SUBSCRIPTION_LINK_INBOX=support@fihaven.app
# Optional default recipient for deploy mail smoke tests (upload.sh / mail-check.js).
# MAIL_CHECK_TO=you@example.com
# Run bill-reminder + trial-ending scheduler in development (always on in production).
# ENABLE_SCHEDULER=1

# ── Sessions & dev helpers ──────────────────────────────────────
# Long-lived "remember this device" token lifetime (days). Default 30.
# TOKEN_TTL_DAYS=30
# Non-production only: seed a dev login user on startup.
# DEV_USER_EMAIL=dev@localhost
# DEV_USER_PASSWORD=changeme
# Tests only: alternate SQLite path (see server/db.js).
# FIHAVEN_TEST_DB_PATH=/tmp/fihaven-test.db
# Tests only: skip HTTP rate limiting.
# DISABLE_RATE_LIMIT=1

# ── In-app purchases (Apple / Google) ─────────────────────────────
# Override default product map (JSON: storeProductId -> {plan, days}). Usually
# leave unset — monthly/yearly/family are built in (see server/billing.js).
# IAP_PRODUCTS={"app.fihaven.pro.monthly":{"plan":"monthly","days":31},"app.fihaven.pro.yearly":{"plan":"yearly","days":366},"app.fihaven.pro.family":{"plan":"family","days":366}}
# 'dev-trust' skips store receipt verification (local only). FORBIDDEN in
# production — the server exits if IAP_VERIFY_MODE=dev-trust when NODE_ENV=production.
# IAP_VERIFY_MODE=production
# Set to 1 to accept Apple StoreKit JWS. When enabled in production, the
# server cryptographically verifies the x5c chain against Apple Root CA - G3
# (decode-only is never used). Leave unset to keep /apple/verify disabled.
# APPLE_VERIFY_ENABLED=1
#
# REQUIRED when APPLE_VERIFY_ENABLED=1 — the server refuses to boot without it
# in production. A valid Apple signature only proves Apple issued the
# transaction, not that it came from THIS app: every App Store receipt chains
# to the same root, so without a bundle id to pin against, a signed receipt
# from any other app on the store would grant Pro here. Comma-separated if you
# ship build variants.
# APPLE_BUNDLE_ID=app.fihaven
#
# Sandbox StoreKit transactions carry the production signing chain, so they are
# rejected in production by default. App Review and TestFlight purchases ARE
# sandbox, so a window has to be opened for them.
#
# Usually there is nothing to open. Every deploy stamps APPLE_SANDBOX_BUILD from
# ios/FiHavenApp/project.yml, and a sandbox purchase whose signed AppTransaction
# names that build is accepted on its own — so the build in review works and
# every other sandbox purchase stays rejected. The window below is the fallback
# for when there is no app transaction to check (builds before iOS 23).
#
# DON'T SET THIS BY HAND. Deploy with the flag instead:
#
#     ./upload.sh --allow-sandbox        # 14 days
#     ./upload.sh --allow-sandbox=30     # 30 days
#
# The flag stamps a DEADLINE into the deployed .env, and this var is
# deliberately excluded from the deploy allowlist so a local value never ships.
# That inverts the failure mode: the window closes on its own even if nobody
# touches it again, and any later deploy without the flag closes it immediately.
# Forgetting is safe; the old boolean made forgetting silent and permanent.
#
# Accepted values if you ever do set it directly:
#   unset / 0            rejected (default)
#   2026-08-17T12:00:00Z accepted until then, then rejected
#   1                    accepted with NO expiry — warned about at every boot
# APPLE_ALLOW_SANDBOX=
#
# Which app build may make sandbox purchases — that build OR NEWER, since the
# iOS deploy rewrites project.yml and deploying web first would otherwise stamp
# the previous number and reject the build actually in review. A newer number
# can't be faked: it comes from an Apple-signed app transaction.
#
# Written by the deploy from project.yml as "<build>,<marketing>" (e.g.
# 22,1.6.1) — don't set it by hand; a stale value would outlive its release.
# APPLE_SANDBOX_BUILD=
#
# GOOGLE_VERIFY_ENABLED=1
# Play Developer API — path to the service-account JSON on the server
# (never commit the JSON). Package must match the Play listing.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/var/www/fihaven.app/data/google-play-sa.json
# GOOGLE_PLAY_PACKAGE=app.fihaven
#
# Play's equivalent of APPLE_ALLOW_SANDBOX. Purchases by a Play Console license
# tester come back through the ordinary API — same shape, no money moved — so
# they are rejected by default rather than granting real Pro forever. Play
# exposes no app version on a purchase, so there is nothing to pin the way
# APPLE_SANDBOX_BUILD pins Apple: this dated window is the only lever.
#
# Same rule as APPLE_ALLOW_SANDBOX — don't set it by hand. `./upload.sh
# --allow-sandbox` stamps both stores at once, and neither ships from .env.
# GOOGLE_ALLOW_TEST_PURCHASES=
# Pub/Sub push auth for Play RTDN (production requires an OIDC Bearer and/or
# this shared token). Audience defaults to
# {PUBLIC_ORIGIN}/api/billing/google/notifications.
#
# The audience check FAILS CLOSED: with neither this nor PUBLIC_ORIGIN set,
# every notification is rejected. That is deliberate — anyone with a Google
# account can mint a Google-signed OIDC token for a service account they
# control, so issuer + signature alone prove nothing about who sent it.
# GOOGLE_PUBSUB_AUDIENCE=
# GOOGLE_PUBSUB_VERIFICATION_TOKEN=
# GOOGLE_PUBSUB_REQUIRE_AUTH=1
# Local path to the JSON for upload.sh only (not deployed to the server .env).
# GOOGLE_PLAY_SA_LOCAL=/Users/you/Downloads/your-project-xxxxx.json
# Max household members for Pro / Family tiers (defaults 0 / 3).
# HOUSEHOLD_MAX_PRO=0
# HOUSEHOLD_MAX_FAMILY=3

# ── Remote push (APNs / FCM) ────────────────────────────────────
# Optional. When unset, the server skips push delivery (email + local
# notifications still work). Native apps register device tokens via
# POST /api/push/register when settings.pushNotifications is on.
#
# Apple Push Notification service (.p8 key from developer.apple.com):
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_PATH=/var/www/fihaven.app/data/apns-key.p8
# APNS_BUNDLE_ID=app.fihaven
# APNS_PRODUCTION=1
# Local path to the .p8 for upload.sh (not deployed verbatim).
# APNS_SA_LOCAL=/Users/you/Downloads/AuthKey_XXXXXXXXXX.p8
#
# Firebase Cloud Messaging (Firebase console → Project settings → Service accounts):
# FCM_SERVICE_ACCOUNT_JSON=/var/www/fihaven.app/data/firebase-sa.json
# FCM_SA_LOCAL=/Users/you/Downloads/fihaven-firebase-adminsdk-xxxxx.json
#
# Web Push (browser notifications, Chrome/Firefox/Edge). Generate a key pair
# with `npx web-push generate-vapid-keys`. When unset, the web "Enable browser
# notifications" button hides itself. Keep the private key secret.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@fihaven.app

# ── Deploy (upload.sh only — not loaded by the server) ──────────
# Copy scripts/examples/upload.example.sh to upload.sh (gitignored).
# These vars are read from your local .env when you run ./upload.sh;
# SSH_* and DEV_USER_* are stripped from the file uploaded to the VPS.
# SSH_HOST=
# SSH_USER=root
# SSH_PASSWORD=
# DEPLOY_PATH=/var/www/fihaven.app
# REMOTE_RESTART_CMD=pm2 restart fihaven --update-env
# BACKUP_RETENTION_DAYS=7