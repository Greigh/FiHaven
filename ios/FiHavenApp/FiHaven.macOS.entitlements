<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store apps must be sandboxed; the iOS entitlements file this
	     replaces has no equivalent key because iOS apps always are. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Without this the sandbox blocks every request to the FiHaven API, so
	     the app launches and then never syncs. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Data export writes a JSON file the user picks in a save panel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Remote push for bill reminders. The value has to track the
	     provisioning profile, exactly as on iOS, so it comes from the same
	     per-configuration build setting. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- Sign in with Apple and passkeys. Associated domains resolve the same
	     applinks/webcredentials entries the iOS build uses; the AASA file is
	     served per team-id.bundle-id, which is identical here. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:fihaven.app</string>
		<string>webcredentials:fihaven.app</string>
	</array>
</dict>
</plist>
