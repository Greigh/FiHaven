{
  "name": "fihaven",
  "version": "1.6.4",
  "private": true,
  "description": "Manual-first personal finance — bills, cards, loans, budget lenses, spending, and debt payoff — with optional bank linking (Plaid), rewards optimizer, and family sharing. Web app plus native iOS and Android clients on a shared Node/SQLite backend with server-side sync and FiHaven Pro subscriptions.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Greigh Studios LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greigh/FiHaven.git"
  },
  "bugs": {
    "url": "https://github.com/Greigh/FiHaven/issues"
  },
  "homepage": "https://fihaven.app/",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "bun@1.4.2",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "dev:css": "tailwindcss -i ./client/css/tailwind-input.css -o ./client/css/tailwind-built.css --watch",
    "build": "npm run build:css && npm run markdown && npm run build:vite",
    "build:css": "tailwindcss -i ./client/css/tailwind-input.css -o ./client/css/tailwind-built.css --minify",
    "build:vite": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "coverage": "vitest run --coverage",
    "ci": "npm run csp:check && npm run sitemap:check && npm run markdown:check && npm run build",
    "csp:check": "node scripts/csp-hashes.js --check",
    "csp:hashes": "node scripts/csp-hashes.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "sitemap:check": "node scripts/generate-sitemap.js --check",
    "markdown": "node scripts/generate-markdown.js",
    "markdown:check": "node scripts/generate-markdown.js --check",
    "check:crawlers": "node scripts/check-crawler-policy.js",
    "bump:build": "node scripts/bump-build.js",
    "bump:build:check": "node scripts/bump-build.js --check",
    "deploy": "bash upload.sh",
    "deploy:ios": "bash scripts/ios-testflight.sh",
    "deploy:android": "node scripts/play-upload.js --build",
    "promo": "node scripts/promo.js",
    "indexnow": "node scripts/submit-indexnow.js",
    "generate:icons": "bash ./scripts/generate-icons.sh",
    "generate:og": "node scripts/generate-og.js",
    "generate:pdfs": "node scripts/dev/generate-pdfs.js",
    "sync:issuer-logos": "node scripts/sync-issuer-logos.js",
    "plaid:sandbox": "node scripts/dev/plaid-sandbox-check.js",
    "paddle:webhook": "node scripts/dev/paddle-webhook-check.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "apns2": "^12.2.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "googleapis": "^181.0.0",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.5.2",
    "plaid": "^47.0.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.5.1": true,
    "better-sqlite3@13.0.3": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "uuid": "^11.1.1",
    "rimraf": "^6.1.3",
    "@codecov/vite-plugin": {
      "vite": "$vite"
    }
  }
}
