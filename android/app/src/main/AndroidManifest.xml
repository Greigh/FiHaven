<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime permission to post bill-reminder notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm scheduled bill reminders after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="FiHaven"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FiHaven">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="FiHaven"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FiHaven">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Verified https App Links for OAuth return
                 (https://fihaven.app/oauth/{apple|google}). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="fihaven.app"
                    android:pathPrefix="/oauth" />
            </intent-filter>
            <!-- Legacy custom-scheme fallback (local dev / pre-association).
                 Prefer the https App Link above — do not put JWTs on this URL. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fihaven" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Fires on-device bill reminders scheduled via AlarmManager. -->
        <receiver
            android:name=".BillReminderReceiver"
            android:exported="false" />

        <!-- Re-arms persisted reminders after a reboot or app update. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- When the app is backgrounded, FCM notification payloads are drawn by
             the system, not FcmPushService — without these it falls back to the
             launcher icon, which flattens to a white disc in the status bar. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_fihaven" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/fh_brand" />
        <!-- ...and the channel, for the same reason. Omitting this does not fail
             loudly: FCM quietly posts to a channel it creates itself, labelled
             "Miscellaneous". Pushed bill reminders then ignore whatever the user
             configured for "Bill reminders" — and are dropped outright if that
             stray channel is muted. Must match NotificationScheduler.CHANNEL_ID. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bill-reminders" />

        <!-- Server push via Firebase Cloud Messaging (requires google-services.json). -->
        <service
            android:name=".FcmPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
